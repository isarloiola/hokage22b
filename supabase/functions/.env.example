# ============================================================
# HOKAGE22B — Exemplo de Variáveis de Ambiente (Supabase Secrets)
# ============================================================
# Configure estes secrets no painel do Supabase ou via CLI:
#   npx supabase secrets set CHAVE=valor --project-ref <SEU_PROJECT_REF>
# NUNCA commite valores reais no repositório.

# URL e chave Service Role do projeto Supabase (injetadas automaticamente nas Edge Functions)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Chave Server API do Pi Developer Portal (obrigatória para aprovar e completar pagamentos Pi)
PI_SERVER_API_KEY=sua_pi_server_api_key_aqui

# Notificações administrativas instantâneas no Telegram (opcional, gratuito)
TELEGRAM_BOT_TOKEN=123456789:seu_token_do_botfather
TELEGRAM_ADMIN_CHAT_ID=seu_chat_id_numerico
TELEGRAM_WEBHOOK_SECRET=uma_senha_aleatoria_para_o_webhook_do_telegram

# Notificações por e-mail via Resend (opcional)
RESEND_API_KEY=re_sua_chave_resend
ADMIN_ALERT_EMAIL=contato@seudominio.com
RESEND_FROM_EMAIL=HOKAGE22B <notificacoes@seudominio.com>
